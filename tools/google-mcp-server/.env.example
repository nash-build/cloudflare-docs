# Copy to `.env` and fill in. NEVER commit the real .env file.

# Path to the OAuth "Desktop app" client JSON downloaded from Google Cloud.
# Keep this OUTSIDE the repository.
GOOGLE_CLIENT_SECRETS_FILE=/home/you/.config/google-mcp/client_secret.json

# Fernet key used to encrypt the local token store at rest.
# Generate one with:  python -m google_mcp.keygen
GOOGLE_MCP_ENCRYPTION_KEY=

# Where encrypted per-account tokens are written.
# Defaults to ~/.config/google-mcp/tokens if unset.
# GOOGLE_MCP_TOKEN_DIR=

# Space-separated OAuth scopes. Default is least-privilege (read-only).
# Add scopes deliberately, e.g. to allow sending:
#   https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send
GOOGLE_MCP_SCOPES=https://www.googleapis.com/auth/gmail.readonly
